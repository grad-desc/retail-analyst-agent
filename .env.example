GEMINI_API_KEY=your-key-from-aistudio
GEMINI_MODEL_NAME=gemini-3.8-flash
# comma-separated, tried in order if the primary is down / out of quota.
# Must differ from GEMINI_MODEL_NAME: duplicates are dropped, so the same value means no fallback at all.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.0-flash,gemini-2.5-flash,gemini-1.5-flash
# billing project for BigQuery (required even for public datasets)
GCP_PROJECT_ID=your-gcp-project
BQ_LOCATION=US
